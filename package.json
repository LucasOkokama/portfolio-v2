{
  "name": "portfolio-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "schemas:file": "tsx lib/scripts/schemas-file.ts",
    "schemas:diff": "tsx lib/scripts/schemas-diff.ts",
    "schemas:parse": "tsx lib/scripts/schemas-parse.ts",
    "lint": "eslint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "audit": "npm audit --audit-level=critical",
    "test": "vitest",
    "test:run": "vitest run",
    "ci": "npm run schemas:diff && npm run schemas:parse && npm run lint && npm run typecheck && npm run format:check && npm run audit && npm run test:run && npm run build"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^13.5.0",
    "next": "^16.3.8",
    "next-intl": "^4.14.8",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.6.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "diff": "^9.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
