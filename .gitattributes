# Normalize all text files to LF in the repository
* text=auto eol=lf

# Windows-specific scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.eot  binary
*.ttf  binary
*.woff binary
*.woff2 binary
*.mp3  binary
*.mp4  binary
*.mov  binary
*.pdf  binary
*.zip  binary
*.gz   binary
*.7z   binary
*.tar  binary
*.dll  binary
*.exe  binary
