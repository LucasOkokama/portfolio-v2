          "location": { "type": "string", "minLength": 1 },
          "participationMode": {
            "type": "string",
            "enum": ["presential", "hybrid", "homeoffice"]
          },
          "linkedIn": {
            "anyOf": [{ "type": "string", "format": "uri" }, { "type": "null" }]
          },
          "website": {
            "anyOf": [{ "type": "string", "format": "uri" }, { "type": "null" }]
          },
          "additionalInformations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
