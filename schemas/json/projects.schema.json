                  "intellijIdea",
                  "java",
                  "javaScript",
                  "jUnit",
                  "matplotlib",
                  "mobX",
                  "mySQL",
                  "nextJS",
                  "nodeJS",
                  "pandas",
                  "php",
                  "playwright",
                  "plotly",
                  "postgreSQL",
                  "postman",
                  "python",
                  "react",
                  "springBoot",
                  "styledComponents",
                  "swagger",
                  "tailwindCSS",
                  "typeScript",
                  "vite",
                  "visualStudioCode",
                  "zod",
                  "alignLeft",
                  "award",
                  "arrowRight",
                  "arrowUpRight",
                  "book",
                  "brain",
                  "brush",
                  "calendar",
                  "caretLeft",
                  "caretRight",
                  "check",
                  "chevronLeft",
                  "chevronRight",
                  "clock",
                  "close",
                  "copyright",
                  "desktopComputer",
                  "externalLink",
                  "fullscreen",
                  "gear",
                  "gitBranch",
                  "globe",
                  "graduationCap",
                  "hash",
                  "imageNotFound",
                  "infoSquareFilled",
                  "label",
                  "layout",
                  "moon",
                  "pencil",
                  "pin",
                  "reload",
                  "scroll",
                  "server",
                  "shift",
                  "spanner",
                  "stack",
                  "star",
                  "suitcase",
                  "sun",
                  "user"
                ]
              },
              { "type": "null" }
            ]
          },
          "overview": {
            "type": "object",
            "properties": {
              "pt": { "type": "string" },
              "en": { "type": "string" }
            },
            "required": ["pt", "en"],
            "additionalProperties": false
          },
          "description": {
            "type": "object",
            "properties": {
              "pt": { "type": "string" },
              "en": { "type": "string" }
            },
            "required": ["pt", "en"],
            "additionalProperties": false
          },
          "keyFeatures": {
            "minItems": 1,
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "pt": { "type": "string" },
                "en": { "type": "string" }
              },
              "required": ["pt", "en"],
              "additionalProperties": false
            }
          },
          "technologies": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": { "type": "string", "minLength": 1 },
                "icon": {
                  "type": "string",
                  "enum": [
                    "fourPointedStar",
                    "logo",
                    "claudeCode",
                    "figma",
                    "gemini",
                    "github",
                    "gmail",
                    "grain",
                    "linkedin",
                    "pexels",
                    "vercel",
                    "earthwise",
                    "korosenku",
                    "lojaVinho",
                    "startdoor",
                    "wemage",
                    "angular",
                    "bootstrap",
                    "c",
                    "chartJS",
                    "css",
                    "docker",
                    "eclipse",
                    "express",
                    "flask",
                    "fuseJS",
