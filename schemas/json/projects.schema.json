{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Reference to the JSON Schema used to validate this file."
    },
    "section": {
      "type": "object",
      "properties": {
        "title": {
          "type": "object",
          "properties": {
            "pt": { "type": "string" },
            "en": { "type": "string" }
          },
          "required": ["pt", "en"],
          "additionalProperties": false
        },
        "command": { "type": "string", "minLength": 1 }
      },
      "required": ["title", "command"],
      "additionalProperties": false
    },
    "projects": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "projectName": {
            "type": "object",
            "properties": {
              "pt": { "type": "string" },
              "en": { "type": "string" }
            },
            "required": ["pt", "en"],
            "additionalProperties": false
          },
          "repository": {
            "type": "object",
            "properties": {
              "owner": { "type": "string", "minLength": 1 },
              "name": { "type": "string", "minLength": 1 }
            },
            "required": ["owner", "name"],
            "additionalProperties": false
          },
          "logo": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "fourPointedStar",
                  "logo",
                  "claudeCode",
                  "figma",
                  "gemini",
                  "github",
                  "gmail",
                  "grain",
                  "linkedin",
                  "pexels",
                  "vercel",
