                    "html5",
                    "intellijIdea",
                    "java",
                    "javaScript",
                    "jUnit",
                    "matplotlib",
                    "mobX",
                    "mySQL",
                    "nextJS",
                    "nodeJS",
                    "pandas",
                    "php",
                    "playwright",
                    "plotly",
                    "postgreSQL",
                    "postman",
                    "python",
                    "react",
                    "springBoot",
                    "styledComponents",
                    "swagger",
                    "tailwindCSS",
                    "typeScript",
                    "vite",
                    "visualStudioCode",
                    "zod",
                    "alignLeft",
                    "award",
                    "arrowRight",
                    "arrowUpRight",
                    "book",
                    "brain",
                    "brush",
                    "calendar",
                    "caretLeft",
                    "caretRight",
                    "check",
                    "chevronLeft",
                    "chevronRight",
                    "clock",
                    "close",
                    "copyright",
                    "desktopComputer",
                    "externalLink",
                    "fullscreen",
                    "gear",
                    "gitBranch",
                    "globe",
                    "graduationCap",
                    "hash",
                    "imageNotFound",
                    "infoSquareFilled",
                    "label",
                    "layout",
                    "moon",
                    "pencil",
                    "pin",
                    "reload",
                    "scroll",
                    "server",
                    "shift",
                    "spanner",
                    "stack",
                    "star",
                    "suitcase",
                    "sun",
                    "user"
                  ]
                }
              },
              "required": ["label", "icon"],
              "additionalProperties": false
            }
          },
          "links": {
            "type": "object",
            "properties": {
              "repository": {
                "anyOf": [
                  { "type": "string", "format": "uri" },
                  { "type": "null" }
                ]
              },
              "design": {
                "anyOf": [
                  { "type": "string", "format": "uri" },
                  { "type": "null" }
                ]
              },
              "live": {
                "anyOf": [
                  { "type": "string", "format": "uri" },
                  { "type": "null" }
                ]
              }
            },
            "required": ["repository", "design", "live"],
            "additionalProperties": false
          },
          "banner": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "available": { "type": "boolean", "const": true },
                  "scrollable": { "type": "boolean" },
                  "default": { "type": "string" },
                  "light": { "type": ["string", "null"] },
                  "dark": { "type": ["string", "null"] }
                },
                "required": [
                  "available",
                  "scrollable",
                  "default",
                  "light",
                  "dark"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "available": { "type": "boolean", "const": false },
                  "scrollable": { "type": "boolean" },
                  "default": { "type": "null" },
                  "light": { "type": "null" },
                  "dark": { "type": "null" }
                },
                "required": [
                  "available",
                  "scrollable",
                  "default",
                  "light",
                  "dark"
                ],
                "additionalProperties": false
              }
            ]
          },
          "screenshots": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "object",
                  "properties": {
                    "pt": { "type": "string" },
                    "en": { "type": "string" }
                  },
                  "required": ["pt", "en"],
                  "additionalProperties": false
                },
                "path": { "type": "string", "minLength": 1 }
              },
              "required": ["name", "path"],
              "additionalProperties": false
            }
          },
          "metadata": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": ["active", "completed", "onHold", "archived"]
              },
              "scope": {
                "type": "string",
                "enum": [
                  "fullStack",
                  "frontend",
                  "backend",
                  "design",
                  "configuration"
                ]
              },
              "category": {
                "type": "string",
                "enum": ["personal", "client", "openSource", "academic"]
              }
            },
            "required": ["status", "scope", "category"],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "projectName",
          "repository",
          "logo",
          "overview",
          "description",
          "keyFeatures",
          "technologies",
          "links",
          "banner",
          "screenshots",
          "metadata"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["section", "projects"],
  "additionalProperties": false
}
